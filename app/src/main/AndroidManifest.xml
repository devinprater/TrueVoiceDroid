<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Package visibility (API 30+): without this, getEngines() hides
         every TTS engine — including this one — and a TextToSpeech client
         silently falls back to the system default. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".TruVoiceApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:mipmap/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TrueVoiceDroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TruVoiceTtsService"
            android:exported="true"
            android:label="@string/service_label">
            <intent-filter>
                <action android:name="android.intent.action.TTS_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- The engine, in a process of its own.  Never exported: only the
             TTS service binds it, and retiring it is how a wedged native call
             is cleared. -->
        <service
            android:name=".TruVoiceWorkerService"
            android:exported="false"
            android:process=":engine" />
    </application>
</manifest>
